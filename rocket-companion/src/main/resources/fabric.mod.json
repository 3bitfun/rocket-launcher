{
  "schemaVersion": 1,
  "id": "rocket_companion",
  "version": "${version}",
  "name": "Rocket Launcher Client",
  "description": "Configurable HUD modules and a drag-and-drop layout editor for Minecraft Java Edition.",
  "environment": "client",
  "entrypoints": { "client": ["com.rocketlauncher.companion.RocketCompanion"] },
  "depends": {
    "fabricloader": ">=${loaderMin}",
    "fabric-screen-api-v1": "*",
    "fabric-rendering-v1": "*",
    "${keyApi}": "*",
    "fabric-lifecycle-events-v1": "*",
    "minecraft": "${minecraft}",
    "java": ">=${javaRelease}"
  }
}
